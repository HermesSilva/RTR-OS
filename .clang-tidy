# RTR-OS - static checks required by the coding rules (D9).
#
# misc-no-recursion enforces the "no recursion" rule. The others look for
# logic errors, undefined behavior and ignored return values.
#
# Disabled, with reason:
#   bugprone-easily-swappable-parameters   flags any function with two adjacent integers
#   clang-analyzer-security.insecureAPI.*  about libc functions the kernel does not have
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  misc-no-recursion,
  misc-unused-parameters,
  -bugprone-easily-swappable-parameters,
  -clang-analyzer-security.insecureAPI.*
HeaderFilterRegex: 'kernel/include/.*'
